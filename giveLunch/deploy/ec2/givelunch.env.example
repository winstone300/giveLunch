SPRING_PROFILES_ACTIVE=prod

SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/givelunch?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=givelunch
SPRING_DATASOURCE_PASSWORD=

SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

SPRING_MAIL_HOST=email-smtp.ap-northeast-2.amazonaws.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
APP_MAIL_FROM=no-reply@example.com

APP_AGENT_AUTH_API_KEY=
APP_RANK_RETENTION=24h

APP_DATA_GO_KR_BASE_URL=https://apis.data.go.kr
APP_DATA_GO_KR_SERVICE_KEY=
APP_DATA_GO_KR_GET_API=/1471000/FoodNtrCpntDbInfo02/getFoodNtrCpntDbInq02
APP_DATA_GO_KR_TYPE=json
APP_DATA_GO_KR_PAGE_SIZE=10
APP_DATA_GO_KR_NUM_OF_ROWS_ADMIN=50
APP_DATA_GO_KR_NUM_OF_ROWS_USER=10

APP_NAVER_IMAGE_BASE_URL=https://openapi.naver.com
APP_NAVER_IMAGE_SEARCH_PATH=/v1/search/image.json
APP_NAVER_IMAGE_CLIENT_ID=
APP_NAVER_IMAGE_CLIENT_SECRET=
APP_NAVER_IMAGE_DISPLAY=5
APP_NAVER_IMAGE_START=1
APP_NAVER_IMAGE_SORT=sim

GIVELUNCH_DB_HOST=127.0.0.1
GIVELUNCH_DB_NAME=givelunch
GIVELUNCH_BACKUP_DIR=/var/backups/givelunch
GIVELUNCH_BACKUP_RETENTION_DAYS=7
# GIVELUNCH_BACKUP_S3_URI=s3://your-bucket/givelunch/mysql
